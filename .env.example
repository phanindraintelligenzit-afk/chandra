# Copy to .env and fill in. Never commit the real .env.
# Placeholders only — never put real credentials in this file.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# One of: bedrock (default), openai (any OpenAI-compatible server), ollama
LLM_PROVIDER=bedrock

# Model name used by the active provider.
#   Bedrock:  anthropic.claude-sonnet-4-5-20250929-v1:0
#   OpenAI:   Qwen/Qwen2.5-32B-Coder-Instruct, gpt-4o, etc.
#   Ollama:   qwen2.5-coder:32b
LLM_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0

# Sampling temperature (0.0 = deterministic, 0.7 = creative)
LLM_TEMPERATURE=0.0

# Max output tokens
LLM_MAX_TOKENS=4096

# ― OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai) ―
# Point this at any server that speaks the OpenAI chat completions API:
#   - vLLM:     http://<host>:8000/v1
#   - Ollama:   http://<host>:11434/v1
#   - llama.cpp: http://<host>:8080/v1
#   - OpenAI:   https://api.openai.com/v1
OPENAI_API_BASE=http://localhost:8000/v1
# For local servers the key is typically ignored; set a real one for OpenAI/Together/Groq.
OPENAI_API_KEY=not-needed-local

# ― Ollama-specific (only used when LLM_PROVIDER=ollama) ―
# OLLAMA_BASE_URL=http://localhost:11434

# ── AWS ───────────────────────────────────────────────────────────────────────
# Use a burner / sandbox account for synthetic env runs.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# Bedrock — Claude Sonnet via langchain_aws.ChatBedrockConverse
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Postgres ──────────────────────────────────────────────────────────────────
# Local dev default matches docker-compose.yml (`make db-up`).
POSTGRES_URL=postgresql+psycopg://chandra:chandra@localhost:5432/chandra

# ── Logging / observability ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_ENVIRONMENT=production
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chandra

# Account under observation (the burner). Used by `chandra run` and the eval harness.
SYNTHETIC_ACCOUNT_ID=

# SNS topic for the escalation node and Digital Worker P1/high-risk alerts.
SNS_TOPIC_ARN=

# ── Jira (analyzer pipeline + Digital Worker tracker updates) ─────────────────
JIRA_SERVER=https://your-org.atlassian.net
JIRA_EMAIL=bot@your-org.com
JIRA_API_TOKEN=
# Project used when the Digital Worker creates tracking issues for
# requests that did not originate in Jira. Defaults to DEV.
JIRA_PROJECT_KEY=DEV

# ── Digital Worker notifications (all optional; unset = channel skipped) ──────
# Slack incoming-webhook URL for workflow outcome notifications.
SLACK_WEBHOOK_URL=
# Microsoft Teams incoming-webhook (connector) URL.
TEAMS_WEBHOOK_URL=
# SMTP email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ── Digital Worker intake security ────────────────────────────────────────────
# When set, POST /webhooks/{source} requires the same value in the
# X-Chandra-Webhook-Token header. Leave unset to accept unauthenticated
# webhooks (development only — set this in production).
CHANDRA_WEBHOOK_TOKEN=

# ── Frontend / deployment ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/backend
FRONTEND_URL=http://localhost:3000
