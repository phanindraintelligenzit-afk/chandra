# Copy this file to .env and fill in all values.
# Never commit the real .env file.

# ── AWS credentials ────────────────────────────────────────────────
# For local dev you can use a named profile (AWS_PROFILE).
# In Docker / CI use explicit keys instead (AWS_PROFILE is ignored in containers).
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Bedrock model ──────────────────────────────────────────────────
# Used by observation_agent and analyzer_agent.
# Example: anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_NAME=

# ── Jira integration ───────────────────────────────────────────────
# JIRA_SERVER: your Atlassian base URL, e.g. https://yourorg.atlassian.net
# JIRA_EMAIL:  your Atlassian account email
# JIRA_API_TOKEN: generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SERVER=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Postgres ───────────────────────────────────────────────────────
# Hostname must match the service name in docker-compose.yml
POSTGRES_URL=postgresql+psycopg://chandra:chandra@postgres:5432/chandra

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Synthetic / burner AWS account ────────────────────────────────
SYNTHETIC_ACCOUNT_ID=
