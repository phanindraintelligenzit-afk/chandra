# Copy to .env and fill in. Never commit the real .env.

# AWS — use a burner / sandbox account for synthetic env runs.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# Bedrock — Claude Sonnet via langchain_aws.ChatBedrockConverse
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Postgres — local dev defaults match docker-compose.yml
POSTGRES_URL=postgresql+psycopg://chandra:chandra@localhost:5432/chandra

# Logging
LOG_LEVEL=INFO

# Account under observation (the burner). Used by `chandra run` and the eval harness.
SYNTHETIC_ACCOUNT_ID=
