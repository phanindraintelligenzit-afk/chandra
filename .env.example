# Copy to .env and fill in. Never commit the real .env.
# Placeholders only — never put real credentials in this file.

# ── AWS ───────────────────────────────────────────────────────────────────────
# Use a burner / sandbox account for synthetic env runs.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# ── LLM provider (src/chandra/llm.build_chat_model) ──────────────────────────
# Which inference backend serves every LLM call. Switching backend is an
# env change only — never a code change. Options:
#   bedrock  (default) — Amazon Bedrock via langchain_aws.ChatBedrockConverse
#   openai   — any OpenAI-compatible endpoint (vLLM, TGI, LM Studio, …)
#   ollama   — local Ollama daemon (uses its OpenAI-compatible /v1 API)
LLM_PROVIDER=bedrock

# Bedrock model (used when LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional per-agent override used by the root agents (observation/analyzer/
# execution/copilot); falls back to the provider's model when unset.
MODEL_NAME=

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai)
OPENAI_API_BASE=
OPENAI_MODEL_NAME=
OPENAI_API_KEY=not-needed

# Local Ollama (used when LLM_PROVIDER=ollama). OLLAMA_MODEL is deliberately
# empty: the production model is selected by benchmarking candidates
# (Gemma / Llama 3.1 8B / Phi-4 / Mistral Small) on Chandra workloads —
# never hardcoded.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# ── Postgres ──────────────────────────────────────────────────────────────────
# Local dev default matches docker-compose.yml (`make db-up`).
POSTGRES_URL=postgresql+psycopg://chandra:chandra@localhost:5432/chandra

# ── Logging / observability ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_ENVIRONMENT=production
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chandra

# Account under observation (the burner). Used by `chandra run` and the eval harness.
SYNTHETIC_ACCOUNT_ID=

# SNS topic for the escalation node and Digital Worker P1/high-risk alerts.
SNS_TOPIC_ARN=

# ── Jira (analyzer pipeline + Digital Worker tracker updates) ─────────────────
JIRA_SERVER=https://your-org.atlassian.net
JIRA_EMAIL=bot@your-org.com
JIRA_API_TOKEN=
# Project used when the Digital Worker creates tracking issues for
# requests that did not originate in Jira. Defaults to DEV.
JIRA_PROJECT_KEY=DEV

# ── Digital Worker notifications (all optional; unset = channel skipped) ──────
# Slack incoming-webhook URL for workflow outcome notifications.
SLACK_WEBHOOK_URL=
# Microsoft Teams incoming-webhook (connector) URL.
TEAMS_WEBHOOK_URL=
# SMTP email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ── Digital Worker intake security ────────────────────────────────────────────
# When set, POST /webhooks/{source} requires the same value in the
# X-Chandra-Webhook-Token header. Leave unset to accept unauthenticated
# webhooks (development only — set this in production).
CHANDRA_WEBHOOK_TOKEN=

# ── Frontend / deployment ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/backend
FRONTEND_URL=http://localhost:3000
