AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
JIRA_SERVER = "https://dummyintelligenzit.atlassian.net"
JIRA_EMAIL = "dummy.intelligenzit@gmail.com"
JIRA_API_TOKEN="YOUR_JIRA_API_TOKEN"
SYNTHETIC_ACCOUNT_ID="YOUR_SYNTHETIC_ACCOUNT_ID"
SNS_TOPIC_ARN="YOUR_SNS_TOPIC_ARN"
POSTGRES_URL="postgresql+psycopg://USER:PASSWORD@localhost:5432/postgres"
NEXT_PUBLIC_API_URL=/api/backend
FRONTEND_URL=https://chandra-v1.onrender.com
CHANDRA_AUTO_APPROVE=1

# ─────────────────────────────────────────────────────────────────────────
# Reasoning engine — swap providers by env only (no code change).
# Business logic talks to the provider through BaseLLM / build_chat_model;
# LLM_PROVIDER selects the backend. Model names are NEVER hardcoded — the
# production model is chosen by benchmark (scripts/benchmark_llm.py).
# ─────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=bedrock

# --- bedrock (default) ---
BEDROCK_MODEL_ID="YOUR_BEDROCK_MODEL_ID"
# Optional per-agent override consumed by the root agents' build_chat_model():
# MODEL_NAME="YOUR_BEDROCK_MODEL_ID"

# --- vLLM (local, OpenAI-compatible) — set LLM_PROVIDER=vllm to use ---
# VLLM_API_BASE="http://localhost:8000/v1"
# VLLM_MODEL="YOUR_APPROVED_LOCAL_MODEL"
# VLLM_API_KEY="not-needed"

# --- any other OpenAI-compatible server (fallback for LLM_PROVIDER=openai/vllm) ---
# OPENAI_API_BASE="http://localhost:8000/v1"
# OPENAI_API_KEY="not-needed"
# OPENAI_MODEL_NAME="YOUR_MODEL"

# --- ollama (local) — set LLM_PROVIDER=ollama to use ---
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="YOUR_MODEL"

# Enforce the typed ExecutionPlan pipeline in the AWS Execution Agent
# (validated plan + deterministic executor only; no generated shell/python
# /terraform via subprocess). Default off — opt in after E2E validation.
# CHANDRA_TYPED_EXECUTION=true

# AWS Execution Agent decoding knobs (deterministic by default). Pinning
# low temperature + a generous output budget keeps Terraform/boto3/JSON
# generation reproducible and un-truncated on a local model. Tune per model
# without code changes; defaults are 0.0 / 1.0 / 8192.
# CHANDRA_AGENT_TEMPERATURE=0.0
# CHANDRA_AGENT_TOP_P=1.0
# CHANDRA_AGENT_MAX_TOKENS=8192

# How the AWS Execution Agent enforces structured output. Bedrock/Claude
# defaults to function_calling (tool use); OpenAI-compatible/vLLM/Ollama
# default to json_schema (vLLM guided decoding — works for ANY model, no
# --tool-call-parser needed). Override only if a server build needs it:
# json_schema | json_mode | function_calling
# CHANDRA_STRUCTURED_OUTPUT_METHOD=json_schema

# Token Budget Manager — per-section char caps on the code-generation prompt
# (~4 chars/token). Custom KRAs ground the generator with full Terraform
# resource docs + live AWS inventory, which bloats the prompt to ~24k tokens
# and truncates the completion (LengthFinishReasonError) on a local model.
# Bedrock is exempt (full context); local providers get these caps. Raise
# them when the vLLM server runs a larger --max-model-len.
# CHANDRA_TF_DOCS_MAX_CHARS=8000
# CHANDRA_AWS_CTX_MAX_CHARS=6000
# CHANDRA_MEMORY_MAX_CHARS=3000