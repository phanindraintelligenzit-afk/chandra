# ═══════════════════════════════════════════════════════════════════════════════
# CHANDRA — Enterprise AI Cloud Operations Platform
# Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── AWS Configuration ────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_PROFILE=
# AWS_PROFILE=my-sandbox  # Use a named profile for sandbox accounts

# ── Database ─────────────────────────────────────────────────────────────────
# Default: PostgreSQL via Docker (docker compose up -d postgres)
# For local SQLite: set DATABASE_URL=sqlite:///./chandra.db
# For remote PostgreSQL: use your cloud connection string
POSTGRES_URL=postgresql+psycopg://chandra:chandra@localhost:5434/chandra
DATABASE_URL=postgresql+psycopg://chandra:chandra@localhost:5434/chandra

# ── Jira Integration ─────────────────────────────────────────────────────────
JIRA_SERVER=https://dummyintelligenzit.atlassian.net
JIRA_EMAIL=dummy.intelligenzit@gmail.com
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN

# ── Slack Integration ────────────────────────────────────────────────────────
# Create a Slack app at https://api.slack.com/apps
# Enable Events API, subscribe to app_mention and message.im
# Set the Request URL to: https://<your-host>/webhooks/slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# ── Microsoft Teams Integration ──────────────────────────────────────────────
# Use Power Automate to create an HTTP-triggered flow
# POST to: https://<your-host>/webhooks/teams
TEAMS_WEBHOOK_URL=

# ── Email Agent Integration ──────────────────────────────────────────────────
# POST to: https://<your-host>/webhooks/email
EMAIL_WEBHOOK_URL=

# ── Webhook Security ─────────────────────────────────────────────────────────
# If set, all webhook endpoints require X-Chandra-Webhook-Token header
# CHANDRA_WEBHOOK_TOKEN=your-secret-token

# ── Frontend / API ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:6001
FRONTEND_URL=http://localhost:3000

# Synthetic environment (eval harness)
SYNTHETIC_ACCOUNT_ID=YOUR_SYNTHETIC_ACCOUNT_ID
SNS_TOPIC_ARN=YOUR_SNS_TOPIC_ARN

# Auto-approve actions (1 = enabled, for development only)
# CHANDRA_AUTO_APPROVE=0

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Provider Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# LLM provider backend. One of:
#   bedrock  — Amazon Bedrock (default, production)
#   vllm     — Local vLLM server (development, air-gapped)
#   openai   — Any OpenAI-compatible endpoint (Together, Groq, etc.)
#   ollama   — Local Ollama daemon
LLM_PROVIDER=bedrock

# Model name for the active provider
#   Bedrock:  anthropic.claude-sonnet-4-5-20250929-v1:0
#   vLLM:     google/gemma-4-12B-it-qat-w4a16-ct
#   OpenAI:   Qwen/Qwen2.5-32B-Coder-Instruct
#   Ollama:   qwen2.5-coder:32b
LLM_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0

# Sampling temperature (0.0 = deterministic for code generation)
LLM_TEMPERATURE=0.0

# ── Bedrock (default) ────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# ── vLLM (local) — set LLM_PROVIDER=vllm to use ──────────────────────────────
# Start vLLM: vllm serve google/gemma-4-12B-it-qat-w4a16-ct --max-model-len 16384 --enable-prefix-caching --gpu-memory-utilization 0.90 --host 0.0.0.0 --port 8000
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
VLLM_API_KEY=not-needed

# ── OpenAI-compatible (fallback) ──────────────────────────────────────────────
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL_NAME=google/gemma-4-12B-it-qat-w4a16-ct

# ── Ollama ───────────────────────────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:32b

# ── Quantization Configuration (for local LLM providers) ─────────────────────
# Supported formats: QAT, GPTQ, AWQ, FP16, BF16
# QAT:    Quantization-Aware Training (gemma-4-12B-it-qat-w4a16-ct uses this)
# GPTQ:   GPTQ 4-bit quantization
# AWQ:    Activation-aware Weight Quantization
# FP16:   Half-precision (default for most models)
# BF16:   Bfloat16 (better numerical stability)
# Read from model name suffix — no quantization implementation needed.
# Example model names:
#   google/gemma-4-12B-it-qat-w4a16-ct  → QAT (4-bit weights, 16-bit activations)
#   TheBloke/Mixtral-8x7B-GPTQ          → GPTQ
#   TheBloke/Llama-2-7B-AWQ             → AWQ
# Unset = use model default
# LLM_QUANTIZATION=qat

# ═══════════════════════════════════════════════════════════════════════════════
# Execution Agent Settings
# ═══════════════════════════════════════════════════════════════════════════════

# Enforce typed ExecutionPlan pipeline (validated plan + deterministic executor)
# CHANDRA_TYPED_EXECUTION=false

# Agent decoding knobs (deterministic by default)
CHANDRA_AGENT_TEMPERATURE=0.0
CHANDRA_AGENT_TOP_P=1.0

# Max output tokens. LEAVE UNSET for vLLM to use full context (context_len - prompt).
# CHANDRA_AGENT_MAX_TOKENS=

# Structured output method
#   json_schema       — vLLM guided decoding (works for any model, no --tool-call-parser needed)
#   function_calling  — Tool-use path (default for Bedrock/Claude)
#   json_mode         — JSON mode (OpenAI-compatible)
CHANDRA_STRUCTURED_OUTPUT_METHOD=json_schema

# ── Token Budget Caps (for local LLM with 16K context) ──────────────────────
# ~4 chars per token. Local models have limited context (16K), so cap sections.
# Bedrock is exempt (full context). Adjust when vLLM --max-model-len increases.
CHANDRA_TF_DOCS_MAX_CHARS=8000
CHANDRA_AWS_CTX_MAX_CHARS=6000
CHANDRA_MEMORY_MAX_CHARS=3000
CHANDRA_AGENT_MAX_INPUT_CHARS=30000

# ═══════════════════════════════════════════════════════════════════════════════
# Observability & Tracing
# ═══════════════════════════════════════════════════════════════════════════════

# LangSmith (LangChain tracing)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=ls__your-key-here
# LANGCHAIN_PROJECT=chandra

# LangFuse (open-source LLM observability)
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# AgentOps (AI agent monitoring)
# AGENTOPS_API_KEY=your-agentops-key

# ═══════════════════════════════════════════════════════════════════════════════
# Logging & Debug
# ═══════════════════════════════════════════════════════════════════════════════

# LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR
# UVICORN_LOG_LEVEL=info