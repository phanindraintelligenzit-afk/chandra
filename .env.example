# Copy to .env and fill in. Never commit the real .env.

# AWS — use a burner / sandbox account for synthetic env runs.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# Bedrock — Claude Sonnet via langchain_aws.ChatBedrockConverse
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Postgres — local dev defaults match docker-compose.yml
POSTGRES_URL=postgresql+psycopg://chandra:chandra@localhost:5432/chandra

# Logging
LOG_LEVEL=INFO

# Account under observation (the burner). Used by `chandra run` and the eval harness.
SYNTHETIC_ACCOUNT_ID=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY="YOUR_LANGSMITH_API_KEY"
LANGSMITH_PROJECT="test"
JIRA_SERVER = "https://malkapurapusivamanikanta.atlassian.net"
JIRA_EMAIL = "malkapurapusivamanikanta@gmail.com"

SNS_TOPIC_ARN="YOUR_SNS_TOPIC_ARN"
JIRA_API_TOKEN="YOUR_JIRA_API_TOKEN"
POSTGRES_URL=postgresql+psycopg://postgres:Manikanta1234%24@localhost:5432/postgres12
NEXT_PUBLIC_API_URL=https://your-domain.com/api/backend
FRONTEND_URL=https://your-domain.com